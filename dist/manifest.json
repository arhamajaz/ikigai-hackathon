{
  "manifest_version": 3,
  "name": "SentinelEdge - Zero-Latency DLP Firewall",
  "version": "2.0.0",
  "description": "Zero-latency, 100% client-side privacy firewall for Generative AI (ChatGPT, Claude, Gemini, Perplexity, Copilot).",
  "permissions": [
    "clipboardRead",
    "activeTab",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sentineledge@local.security",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module",
    "scripts": [
      "service-worker-loader.js"
    ]
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "SentinelEdge DLP v2.0.0"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-D6OS4KGA.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://*.bing.com/chat*",
        "https://www.bing.com/search*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.bing.com/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://www.bing.com/*",
        "https://www.perplexity.ai/*"
      ],
      "resources": [
        "assets/index.ts-D6OS4KGA.js"
      ],
      "use_dynamic_url": false
    }
  ]
}