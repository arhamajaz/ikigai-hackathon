{
  "manifest_version": 3,
  "name": "SentinelEdge v1.2",
  "version": "1.2.0",
  "description": "Real-Time Client-Side DLP Firewall Chrome & Firefox Extension",
  "permissions": [
    "clipboardRead",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sentineledge@local.extension",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-DfXm3HZB.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "resources": [
        "assets/index.ts-DfXm3HZB.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
